{
  "expo": {
    "name": "app",
    "slug": "app",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Check-It to access your camera to scan product packaging, verify MRP, and extract statutory declarations.",
        "NSPhotoLibraryUsageDescription": "Allow Check-It to access your photo library to select product packaging images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "navigationBarColor": "#111118",
      "navigationBarStyle": "light",
      "package": "com.harish2007328.app",
      "edgeToEdge": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-navigation-bar",
      "expo-updates",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Check-It to access your camera to scan product packaging, verify MRP, and extract statutory declarations."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Check-It to access your photo library to select product packaging images."
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "expo-navigation-bar": {},
      "groqApiKey": "",
      "eas": {
        "projectId": "0f478a5e-6695-4da0-9e68-2a9ac106b256"
      }
    },
    "owner": "harish2007328",
    "updates": {
      "url": "https://u.expo.dev/0f478a5e-6695-4da0-9e68-2a9ac106b256"
    }
  }
}
